rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isSignedIn()
        && currentUser().active == true
        && currentUser().role in ['admin', 'staff'];
    }

    match /users/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isStaff());

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'student'
        && request.resource.data.active == true;

      allow update: if isStaff()
        || (isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'updatedAt']));

      allow delete: if isStaff();
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /reports/{reportId} {
      allow read: if isSignedIn()
        && (resource.data.reporterId == request.auth.uid || isStaff());

      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'Abierto'
        && request.resource.data.priority in ['Baja', 'Media', 'Alta']
        && request.resource.data.assigneeId == null
        && request.resource.data.resolvedAt == null;

      allow update: if isStaff()
        || (isSignedIn()
          && resource.data.reporterId == request.auth.uid
          && resource.data.status == 'Abierto'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'description', 'categoryId', 'priority',
              'location', 'evidencePath', 'updatedAt']));

      allow delete: if false;

      match /history/{eventId} {
        function parentReport() {
          return get(/databases/$(database)/documents/reports/$(reportId)).data;
        }

        function parentReportAfterWrite() {
          return getAfter(/databases/$(database)/documents/reports/$(reportId)).data;
        }

        allow read: if isSignedIn()
          && (parentReport().reporterId == request.auth.uid || isStaff());

        allow create: if isSignedIn()
          && request.resource.data.actorId == request.auth.uid
          && (parentReportAfterWrite().reporterId == request.auth.uid || isStaff())
          && request.resource.data.type in
            ['created', 'status_changed', 'assigned', 'commented'];

        allow update, delete: if false;
      }
    }
  }
}
